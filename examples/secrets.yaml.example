# Copy to secrets.yaml next to your device YAML and fill in. Never commit secrets.yaml.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
api_encryption_key: "generate with: openssl rand -base64 32"
ota_password: "generate with: openssl rand -hex 16"
remeha_display_template: "copy the 52-hex-character value from the device log"
